---
const features = [
  {
    icon: '🥩',
    title: 'Thịt tươi mỗi ngày',
    description: 'Nguyên liệu được tuyển chọn, nhập hàng mỗi ngày đảm bảo tươi ngon nhất.',
  },
  {
    icon: '📞',
    title: 'Đặt bàn trực tuyến',
    description: 'Đặt bàn nhanh chóng qua website hoặc hotline 24/7.',
  },
  {
    icon: '🌿',
    title: 'Không gian sân vườn',
    description: 'Không gian xanh mát, thoáng đãng, lý tưởng cho gia đình và nhóm bạn.',
  },
  {
    icon: '🚗',
    title: 'Bãi đỗ xe rộng',
    description: 'Bãi đỗ xe miễn phí, rộng rãi ngay tại nhà hàng.',
  },
];
---

<section id="features" class="py-16 bg-gray-50">
  <div class="container">
    <p class="text-brand-gold font-semibold uppercase tracking-widest text-sm mb-1 text-center">Tại sao chọn chúng tôi</p>
    <h2 class="section-title text-center">Điểm khác biệt của Bê Thui Hà Nội</h2>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mt-10">
      {features.map((f) => (
        <div class="flex flex-col items-center text-center">
          <span class="text-5xl mb-4">{f.icon}</span>
          <h3 class="font-bold text-brand-green mb-2">{f.title}</h3>
          <p class="text-gray-500 text-sm leading-relaxed">{f.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
