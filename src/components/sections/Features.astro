---
import { Image } from "astro:assets";
import { getText as t } from "@/lib/googleSheets";
import { imgSrc } from "@/lib/utils";

const features = [
  {
    icon: t("sections.features.item1.icon"),
    title: t("sections.features.item1.title"),
    description: t("sections.features.item1.desc"),
  },
  {
    icon: t("sections.features.item2.icon"),
    title: t("sections.features.item2.title"),
    description: t("sections.features.item2.desc"),
  },
  {
    icon: t("sections.features.item3.icon"),
    title: t("sections.features.item3.title"),
    description: t("sections.features.item3.desc"),
  },
  {
    icon: t("sections.features.item4.icon"),
    title: t("sections.features.item4.title"),
    description: t("sections.features.item4.desc"),
  },
];
---

<section id="features" class="py-16 bg-gray-50">
  <div class="container">
    <p class="text-brand-gold font-semibold uppercase tracking-widest text-sm mb-1 text-center">
      {t("sections.features.eyebrow")}
    </p>
    <h2 class="section-title text-center">{t("sections.features.title")}</h2>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mt-10">
      {
        features.map((f) => (
          <div class="flex flex-col items-center text-center">
            <div class="h-16 w-16 mb-4 flex items-center justify-center">
              {f.icon.startsWith("/") || f.icon.startsWith("http") ? (
                <Image
                  src={imgSrc(f.icon)}
                  alt={f.title}
                  width={64}
                  height={64}
                  class="h-full w-auto object-contain"
                />
              ) : (
                <span class="text-5xl">{f.icon}</span>
              )}
            </div>
            <h3 class="font-bold text-brand-green mb-2">{f.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{f.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
