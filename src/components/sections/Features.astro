---
import { getSiteConfig, getText as t } from "@/lib/googleSheets";
import { imgSrc } from "@/lib/utils";
import { Image } from "astro:assets";
import logo from "@/assets/logo.svg";

const config = getSiteConfig();
const mapLink = config.mapEmbedUrl?.substring(0, config.mapEmbedUrl?.length - 13);

const featuresList = [
  { icon: "/icons/icon-be.png", text: "Bê thui nguyên con, luôn tươi mới" },
  { icon: "/icons/online-order.png", text: "Hỗ trợ đặt hàng Online dễ dàng" },
  { icon: "/icons/FREE-WIFI.png", text: "Sóng wifi mạnh phủ khắp Quán" },
  { icon: "/icons/ship-tan-nha.png", text: "Giao hàng tận nơi với các đơn Online" },
];

const contactItems = [
  {
    icon: "phone",
    label: "Hotline",
    value: config.hotline,
    description: t("sections.contact.hotline.desc") || "Hotline đặt hàng và tư vấn 24/7",
    action: `location.href='tel:${config.hotline}'`,
  },
  {
    icon: "email",
    label: "Email",
    value: config.email,
    description: t("sections.contact.email.desc") || "Email nhận báo giá, yêu cầu xuất hóa đơn",
    action: `location.href='mailto:${config.email}'`,
  },
  {
    icon: "location",
    label: "Địa chỉ",
    value: config.address,
    description: "",
    action: `window.open('${mapLink}', '_blank')`,
  },
];
---

<section id="features" class="relative py-16 md:py-20 overflow-hidden">
  <!-- Background Image - Use the bg.jpeg as specified -->
  <div
    class="absolute inset-0 bg-cover bg-center bg-no-repeat bg-fixed"
    style="background-image: url('https://bethuihanoi.vn/wp-content/uploads/2023/10/bg.jpeg');"
  >
  </div>

  <!-- Dark Overlay -->
  <div class="absolute inset-0 bg-black/80"></div>

  <!-- Sparkle Effect -->
  <div class="absolute inset-0 pointer-events-none effect-sparkle"></div>

  <!-- Content -->
  <div class="container relative z-10">
    <!-- Section Title -->
    <div class="text-center mb-12">
      <div class="flex items-center justify-center mb-4">
        <Image src={logo} alt="Bê thui Hà Nội" width={120} height={120} />
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-brand-gold mb-6">
        Tại sao nên chọn Bê thui Hà Nội
      </h2>
      <div class="max-w-4xl mx-auto space-y-4 text-white/90 text-sm md:text-base leading-relaxed">
        <p>
          Đến với hệ thống nhà hàng Bê thui Hà Nội, chúng tôi tôn trọng và yêu quý món ăn truyền
          thống này bằng cách sử dụng chỉ những nguyên liệu tươi ngon nhất và quy trình nướng chín
          đều tinh tế. Thịt bê được cắt thành từng miếng mỏng và đặc biệt được kết hợp với các loại
          gia vị và rau sống tươi ngon, để tạo ra một trải nghiệm ẩm thực không thể quên.
        </p>
        <p>
          Chúng tôi cam kết mang đến cho bạn một không gian thoáng mát và thoải mái, nơi bạn có thể
          thư giãn và tận hưởng bữa tối đầy hương vị. Đội ngũ nhân viên chuyên nghiệp và nhiệt tình
          của chúng tôi luôn sẵn sàng phục vụ bạn và đảm bảo bạn có một bữa ăn trọn vẹn.
        </p>
      </div>
    </div>

    <!-- 4 Features Row -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8 mb-16">
      {
        featuresList.map((feature) => (
          <div class="bg-black/40 backdrop-blur-sm border border-white/10 rounded-xl p-6 text-center hover:-translate-y-2 transition-transform duration-300 group flex flex-col items-center justify-center">
            <div class="w-20 h-20 mb-4 flex items-center justify-center">
              <Image
                src={imgSrc(feature.icon)}
                alt={feature.text}
                width={120}
                height={120}
                class="w-20 h-20 object-contain"
              />
            </div>
            <p class="font-semibold text-sm md:text-base leading-snug text-white">{feature.text}</p>
          </div>
        ))
      }
    </div>

    <!-- YouTube Video -->
    <div
      class="w-full max-w-5xl mx-auto rounded-2xl overflow-hidden shadow-2xl border border-white/10 relative mb-16"
      style="padding-top: 56.25%;"
    >
      <iframe
        class="absolute inset-0 w-full h-full"
        loading="lazy"
        title="Bê Thui Hà Nội - Quán Nhậu Sân Vườn Độc Đáo Tại Việt Hưng, Long Biên, Hà Nội"
        src="https://www.youtube.com/embed/Eg3HMeGkmBA?feature=oembed"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      >
      </iframe>
    </div>

    <!-- Features Grid (Adapted to 3 contact items) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
      {
        contactItems.map((item) => (
          <div
            onclick={item.action}
            class="bg-black/40 backdrop-blur-sm border border-white/10 rounded-xl p-8 text-center hover:-translate-y-2 transition-transform duration-300 group cursor-pointer"
          >
            <div class="w-24 h-24 mx-auto mb-6 bg-white/5 rounded-full flex items-center justify-center group-hover:bg-brand-gold/20 transition-colors">
              {item.icon === "phone" && (
                <Image
                  src={imgSrc("features/phone-icon.png")}
                  alt={item.label}
                  width={120}
                  height={120}
                  class="w-16 h-16 object-contain"
                />
              )}
              {item.icon === "email" && (
                <Image
                  src={imgSrc("features/mail-icon.png")}
                  alt={item.label}
                  width={120}
                  height={120}
                  class="w-16 h-16 object-contain"
                />
              )}
              {item.icon === "location" && (
                <Image
                  src={imgSrc("features/map-icon.png")}
                  alt={item.label}
                  width={120}
                  height={120}
                  class="w-16 h-16 object-contain"
                />
              )}
            </div>

            <p class="text-brand-gold font-bold text-lg mb-2">
              {item.icon === "phone" ? `Hotline: ${item.value}` : item.value}
            </p>

            <p class="text-white/70 text-sm">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Sparkle Effect Animation */
  .effect-sparkle {
    background-image:
      url("https://bethuihanoi.vn/wp-content/themes/flatsome/assets/img/effects/sparkle1.png"),
      url("https://bethuihanoi.vn/wp-content/themes/flatsome/assets/img/effects/sparkle2.png");
    animation: sparkle 60s linear infinite;
  }

  @keyframes sparkle {
    0% {
      background-position:
        0 0,
        0 0;
    }
    100% {
      background-position:
        1000px 1000px,
        -500px 500px;
    }
  }
</style>
