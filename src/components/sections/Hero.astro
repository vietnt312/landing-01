---
import { getSlides } from "@/lib/googleSheets";
import { imgSrc } from "@/lib/utils";

const slides = getSlides();
---

<section id="hero" class="relative w-full overflow-hidden">
  <!-- Slides -->
  <div id="slider-track" class="flex transition-transform duration-700 ease-out cursor-grab active:cursor-grabbing select-none">
    {
      slides.map((slide, i) => (
        <div
          id={`slide-${i}`}
          class="slide flex-shrink-0 w-full min-h-[560px] md:min-h-[680px] bg-cover bg-center flex items-center relative"
          style={`background-image: url('${imgSrc(slide.image)}')`}
          aria-hidden={i !== 0}
        >
          {/* dark overlay */}
          <div class="absolute inset-0 bg-black/50" />

          <div class="container relative z-10 text-white pt-32 pb-16">
            <div class="max-w-lg bg-black/60 rounded-2xl p-8 backdrop-blur-md border border-white/10">
              <h1 class="text-4xl md:text-5xl font-bold mb-3">{slide.title}</h1>
              <p class="text-lg mb-6 opacity-90">{slide.subtitle}</p>
              <a href={slide.ctaHref} class="btn-primary">
                {slide.ctaLabel}
              </a>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Prev / Next arrows -->
  {
    slides.length > 1 && (
      <>
        <button
          id="slider-prev"
          aria-label="Slide trước"
          class="absolute left-4 top-1/2 -translate-y-1/2 z-20 bg-black/40 hover:bg-black/70 text-white rounded-full p-3 transition-colors"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <button
          id="slider-next"
          aria-label="Slide tiếp theo"
          class="absolute right-4 top-1/2 -translate-y-1/2 z-20 bg-black/40 hover:bg-black/70 text-white rounded-full p-3 transition-colors"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>

        {/* <!-- Dot indicators --> */}
        <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-20 flex gap-2">
          {slides.map((_, i) => (
            <button
              class:list={[
                "dot w-3 h-3 rounded-full transition-colors",
                i === 0 ? "bg-brand-gold" : "bg-white/50 hover:bg-white/80",
              ]}
              data-index={i}
              aria-label={`Slide ${i + 1}`}
            />
          ))}
        </div>
      </>
    )
  }
</section>

<script is:inline define:vars={{ total: slides.length }}>
  if (total <= 1) {
    // Nothing to do for a single slide
  } else {
    let current = 0;
    let timer = null;

    // Drag/swipe variables
    let isDragging = false;
    let startX = 0;
    let currentX = 0;
    let dragOffset = 0;
    const swipeThreshold = 50; // minimum distance for swipe in pixels

    const slideEls = document.querySelectorAll(".slide");
    const dots = document.querySelectorAll(".dot");
    const sliderTrack = document.getElementById("slider-track");

    function updateTransform(transition = true) {
      if (!sliderTrack) return;

      if (transition) {
        sliderTrack.style.transition = "transform 0.7s ease-out";
      } else {
        sliderTrack.style.transition = "none";
      }

      const offset = -(current * 100) + dragOffset;
      sliderTrack.style.transform = `translateX(${offset}%)`;
    }

    function goTo(index) {
      // Update dots
      dots[current].classList.replace("bg-brand-gold", "bg-white/50");

      // Update aria-hidden
      slideEls[current].setAttribute("aria-hidden", "true");

      current = (index + total) % total;

      slideEls[current].setAttribute("aria-hidden", "false");
      dots[current].classList.replace("bg-white/50", "bg-brand-gold");

      dragOffset = 0;
      updateTransform(true);
    }

    function startAutoPlay() {
      timer = setInterval(() => goTo(current + 1), 5000);
    }

    function resetAutoPlay() {
      clearInterval(timer);
      startAutoPlay();
    }

    // Drag/swipe handlers
    function handleDragStart(e) {
      isDragging = true;
      startX = e.type.includes("mouse") ? e.pageX : e.touches[0].pageX;
      currentX = startX;

      // Disable transition during drag
      if (sliderTrack) {
        sliderTrack.style.transition = "none";
      }
    }

    function handleDragMove(e) {
      if (!isDragging) return;

      currentX = e.type.includes("mouse") ? e.pageX : e.touches[0].pageX;
      const diff = currentX - startX;

      // Calculate drag offset as percentage of viewport width
      const viewportWidth = window.innerWidth;
      dragOffset = (diff / viewportWidth) * 100;

      updateTransform(false);
    }

    function handleDragEnd() {
      if (!isDragging) return;
      isDragging = false;

      const diff = startX - currentX;

      if (Math.abs(diff) > swipeThreshold) {
        if (diff > 0) {
          // Swiped left - go to next
          goTo(current + 1);
        } else {
          // Swiped right - go to previous
          goTo(current - 1);
        }
        resetAutoPlay();
      } else {
        // Snap back to current slide
        dragOffset = 0;
        updateTransform(true);
      }
    }

    // Mouse events for desktop drag
    sliderTrack?.addEventListener("mousedown", handleDragStart);
    sliderTrack?.addEventListener("mousemove", handleDragMove);
    sliderTrack?.addEventListener("mouseup", handleDragEnd);
    sliderTrack?.addEventListener("mouseleave", handleDragEnd);

    // Touch events for mobile swipe
    sliderTrack?.addEventListener("touchstart", handleDragStart, { passive: true });
    sliderTrack?.addEventListener("touchmove", handleDragMove, { passive: true });
    sliderTrack?.addEventListener("touchend", handleDragEnd);

    // Arrow button handlers
    document.getElementById("slider-prev")?.addEventListener("click", () => {
      goTo(current - 1);
      resetAutoPlay();
    });

    document.getElementById("slider-next")?.addEventListener("click", () => {
      goTo(current + 1);
      resetAutoPlay();
    });

    // Dot indicator handlers
    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        goTo(Number(dot.dataset.index));
        resetAutoPlay();
      });
    });

    // Initialize position
    updateTransform(false);
    startAutoPlay();
  }
</script>
