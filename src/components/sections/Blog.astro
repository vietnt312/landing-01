---
import BlogCard from '@/components/ui/BlogCard.astro';
import { getBlogPosts } from '@/lib/googleSheets';

const posts = (await getBlogPosts()).slice(0, 3);
---

{posts.length > 0 && (
  <section id="blog" class="py-16 bg-gray-50">
    <div class="container">
      <p class="text-brand-gold font-semibold uppercase tracking-widest text-sm mb-1">Tin tức</p>
      <h2 class="section-title">Tin tức & sự kiện</h2>
      <p class="section-subtitle">Cập nhật những tin mới nhất từ Bê Thui Hà Nội</p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {posts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/news" class="btn-outline">Xem tất cả tin tức</a>
      </div>
    </div>
  </section>
)}
