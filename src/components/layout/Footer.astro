---
const quickLinks = [
  { label: 'Trang chủ',       href: '/' },
  { label: 'Giới thiệu',      href: '/about' },
  { label: 'Thực đơn',        href: '/menu' },
  { label: 'Đặt bàn',         href: '/booking' },
  { label: 'Tin tức',         href: '/news' },
  { label: 'Liên hệ',         href: '/contact' },
];
---

<footer class="bg-brand-green text-white mt-16">
  <div class="container grid grid-cols-1 md:grid-cols-3 gap-10 py-12">

    <!-- Brand + contact -->
    <div>
      <img src="/images/logo.png" alt="Bê Thui Hà Nội" class="h-16 mb-4" />
      <p class="text-sm leading-relaxed opacity-80 mb-4">
        Hệ thống Nhà hàng Bê thui Hà Nội - Quán nhậu sân vườn chất lượng cao.
      </p>
      <ul class="space-y-2 text-sm">
        <li>
          <a href="tel:0828662929" class="hover:text-brand-gold transition-colors">
            📞 Hotline: 082.866.2929
          </a>
        </li>
        <li>
          <a href="mailto:bethuihanoi@gmail.com" class="hover:text-brand-gold transition-colors">
            ✉️ bethuihanoi@gmail.com
          </a>
        </li>
        <li>📍 28 Nguyễn Hữu Thọ, Định Công, Hà Nội</li>
      </ul>

      <!-- Social links -->
      <div class="flex gap-4 mt-6">
        <a href="#" aria-label="Facebook" class="hover:text-brand-gold transition-colors">
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3l-.5 3H13v6.8c4.56-.93 8-4.96 8-9.8z"/>
          </svg>
        </a>
        <a href="#" aria-label="TikTok" class="hover:text-brand-gold transition-colors">
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.79 1.53V6.79a4.85 4.85 0 01-1.02-.1z"/>
          </svg>
        </a>
        <a href="#" aria-label="YouTube" class="hover:text-brand-gold transition-colors">
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M21.8 8s-.2-1.4-.8-2c-.8-.8-1.6-.8-2-.9C16.4 5 12 5 12 5s-4.4 0-7 .1c-.4.1-1.2.1-2 .9-.6.6-.8 2-.8 2S2 9.6 2 11.2v1.5c0 1.6.2 3.2.2 3.2s.2 1.4.8 2c.8.8 1.8.8 2.2.9C6.8 19 12 19 12 19s4.4 0 7-.1c.4-.1 1.2-.1 2-.9.6-.6.8-2 .8-2s.2-1.6.2-3.2v-1.5C22 9.6 21.8 8 21.8 8zM9.7 14.5V9.5l5.4 2.5-5.4 2.5z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Quick links -->
    <div>
      <h3 class="font-bold text-brand-gold mb-4 uppercase tracking-wide text-sm">Liên kết nhanh</h3>
      <ul class="space-y-2 text-sm">
        {quickLinks.map(({ label, href }) => (
          <li>
            <a href={href} class="hover:text-brand-gold transition-colors opacity-80 hover:opacity-100">
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Opening hours -->
    <div>
      <h3 class="font-bold text-brand-gold mb-4 uppercase tracking-wide text-sm">Giờ mở cửa</h3>
      <ul class="space-y-2 text-sm opacity-80">
        <li>Thứ 2 – Thứ 6: 10:00 – 22:00</li>
        <li>Thứ 7 – Chủ nhật: 09:00 – 23:00</li>
      </ul>

      <h3 class="font-bold text-brand-gold mt-6 mb-4 uppercase tracking-wide text-sm">Bản đồ</h3>
      <div class="rounded-xl overflow-hidden aspect-video">
        <iframe
          src="https://maps.google.com/maps?q=28+Nguyen+Huu+Tho,+Dinh+Cong,+Hanoi&output=embed"
          class="w-full h-full border-0"
          loading="lazy"
          title="Bản đồ nhà hàng"
        ></iframe>
      </div>
    </div>

  </div>

  <div class="border-t border-white/10 py-4 text-center text-xs opacity-60">
    © {new Date().getFullYear()} Bê Thui Hà Nội. All rights reserved.
  </div>
</footer>
