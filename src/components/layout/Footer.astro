---
import { Image } from "astro:assets";
import logo from "@/assets/logo.svg";
import { getText as t, getSiteConfig } from "@/lib/googleSheets";

const config = getSiteConfig();

// Prepare Locations data
const locations = [
  {
    name: "Cơ sở 1",
    address: config.address,
    embedUrl: config.mapEmbedUrl,
  },
  {
    name: "Cơ sở 2",
    address: config.address2,
    embedUrl: config.mapEmbedUrl2,
  },
].filter((loc) => loc.address && loc.embedUrl);

// Helper to format map URLs
const getMapData = (rawMapUrl: string | undefined) => {
  if (!rawMapUrl) return { src: "", link: "" };
  const src =
    rawMapUrl.includes("google.com") &&
    !rawMapUrl.includes("output=embed") &&
    !rawMapUrl.includes("/embed")
      ? `${rawMapUrl}${rawMapUrl.includes("?") ? "&" : "?"}output=embed`
      : rawMapUrl;
  const link = rawMapUrl.replace("&output=embed", "").replace("?output=embed", "");
  return { src, link };
};

const mapData = locations.map((loc) => ({
  ...loc,
  ...getMapData(loc.embedUrl),
}));

const base = import.meta.env.BASE_URL;

const quickLinks = [
  { label: t("layout.header.nav.home"), href: base },
  { label: t("layout.header.nav.about"), href: `${base}about` },
  { label: t("layout.header.nav.menu"), href: `${base}menu` },
  { label: t("layout.header.nav.booking"), href: `${base}booking` },
  { label: t("layout.header.nav.contact"), href: `${base}contact` },
];
---

<footer class="bg-black/90 text-white border-t border-white/10">
  <div class="container grid grid-cols-1 md:grid-cols-2 gap-16 py-16">
    <!-- Column 1: Brand + Contact + Socials -->
    <div>
      <a href={base} class="inline-block mb-6">
        <Image src={logo} alt={t("layout.header.logo_alt")} class="h-24 w-auto" />
      </a>
      <p class="text-sm leading-relaxed opacity-70 mb-6 max-w-xs">
        {t("layout.footer.brand_desc")}
      </p>

      <ul class="space-y-3 text-sm mb-8 opacity-80">
        {
          config.hotline && (
            <li>
              <span class="text-brand-gold font-semibold uppercase text-xs block mb-1">
                Hotline
              </span>
              <a href={`tel:${config.hotline}`} class="hover:text-brand-gold transition-colors">
                {config.hotline}
              </a>
            </li>
          )
        }
        {
          config.email && (
            <li>
              <span class="text-brand-gold font-semibold uppercase text-xs block mb-1">Email</span>
              <a href={`mailto:${config.email}`} class="hover:text-brand-gold transition-colors">
                {config.email}
              </a>
            </li>
          )
        }
        {
          locations.map((loc, idx) => (
            <li>
              <span class="text-brand-gold font-semibold uppercase text-xs block mb-1">
                Địa chỉ {locations.length > 1 ? idx + 1 : ""}
              </span>
              {loc.address}
            </li>
          ))
        }
      </ul>

      <!-- Social links -->
      <div class="flex gap-3">
        {
          config.facebook && (
            <a
              href={config.facebook}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
              class="w-10 h-10 rounded-full bg-[#1877F2] flex items-center justify-center text-white hover:scale-110 transition-transform"
            >
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3l-.5 3H13v6.8c4.56-.93 8-4.96 8-9.8z" />
              </svg>
            </a>
          )
        }
        {
          config.tiktok && (
            <a
              href={config.tiktok}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="TikTok"
              class="w-10 h-10 rounded-full bg-[#010101] flex items-center justify-center text-white hover:scale-110 transition-transform border border-white/10"
            >
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.79 1.53V6.79a4.85 4.85 0 01-1.02-.1z" />
              </svg>
            </a>
          )
        }
        {
          config.email && (
            <a
              href={`mailto:${config.email}`}
              aria-label="Email"
              class="w-10 h-10 rounded-full bg-black/80 flex items-center justify-center text-white hover:scale-110 transition-transform border border-white/10"
            >
              <svg
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2-2v10a2 2 0 002 2z"
                />
              </svg>
            </a>
          )
        }
        {
          config.hotline && (
            <a
              href={`tel:${config.hotline}`}
              aria-label="Hotline"
              class="w-10 h-10 rounded-full bg-[#25D366] flex items-center justify-center text-white hover:scale-110 transition-transform"
            >
              <svg
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                />
              </svg>
            </a>
          )
        }
        {
          config.youtube && (
            <a
              href={config.youtube}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="YouTube"
              class="w-10 h-10 rounded-full bg-[#FF0000] flex items-center justify-center text-white hover:scale-110 transition-transform"
            >
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M21.8 8s-.2-1.4-.8-2c-.8-.8-1.6-.8-2-.9C16.4 5 12 5 12 5s-4.4 0-7 .1c-.4.1-1.2.1-2 .9-.6.6-.8 2-.8 2S2 9.6 2 11.2v1.5c0 1.6.2 3.2.2 3.2s.2 1.4.8 2c.8.8 1.8.8 2.2.9C6.8 19 12 19 12 19s4.4 0 7-.1c.4-.1 1.2-.1 2-.9.6-.6.8-2 .8-2s.2-1.6.2-3.2v-1.5C22 9.6 21.8 8 21.8 8zM9.7 14.5V9.5l5.4 2.5-5.4 2.5z" />
              </svg>
            </a>
          )
        }
      </div>
    </div>

    <!-- Column 2: Map -->
    <div>
      <div class="flex items-center justify-between mb-8">
        <h3 class="font-bold text-brand-gold uppercase tracking-widest text-sm">
          {t("layout.footer.map_title")}
        </h3>

        {
          mapData.length > 1 && (
            <div class="flex gap-2 bg-white/5 p-1 rounded-lg">
              {mapData.map((_, idx) => (
                <button
                  class={`px-3 py-1 text-xs rounded-md transition-all duration-300 map-tab-btn ${idx === 0 ? "bg-brand-gold text-black font-bold" : "text-white/60 hover:text-white"}`}
                  data-idx={idx}
                >
                  CS {idx + 1}
                </button>
              ))}
            </div>
          )
        }
      </div>

      <div class="space-y-4">
        {
          mapData.map((map, idx) => (
            <div
              id={`map-container-${idx}`}
              class={`rounded-2xl overflow-hidden shadow-2xl border border-white/5 aspect-video hover:border-brand-gold/50 transition-all duration-500 cursor-pointer map-container ${idx === 0 ? "block" : "hidden opacity-0"}`}
              onclick={`window.open('${map.link}', '_blank')`}
            >
              <iframe
                src={map.src}
                class="w-full h-full pointer-events-none"
                loading="lazy"
                title={`${t("layout.footer.map_title")} - ${map.name}`}
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div
    class="border-t border-white/5 py-2 text-center text-[10px] uppercase tracking-widest opacity-60 bg-brand-green text-white"
  >
    {config.copyright ?? `© ${new Date().getFullYear()} Bê Thui Hà Nội. All rights reserved.`}
  </div>

  <script is:inline>
    const tabBtns = document.querySelectorAll(".map-tab-btn");
    const mapContainers = document.querySelectorAll(".map-container");

    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const idx = btn.getAttribute("data-idx");

        // Update buttons
        tabBtns.forEach((b) => {
          b.classList.remove("bg-brand-gold", "text-black", "font-bold");
          b.classList.add("text-white/60");
        });
        btn.classList.add("bg-brand-gold", "text-black", "font-bold");
        btn.classList.remove("text-white/60");

        // Update maps
        mapContainers.forEach((container, cIdx) => {
          if (cIdx === parseInt(idx)) {
            container.classList.remove("hidden");
            setTimeout(() => container.classList.remove("opacity-0"), 10);
          } else {
            container.classList.add("opacity-0");
            setTimeout(() => container.classList.add("hidden"), 500);
          }
        });
      });
    });
  </script>
</footer>
