---
import { Image } from "astro:assets";
import logo from "@/assets/logo.svg";
import { getText as t } from "@/lib/googleSheets";

const base = import.meta.env.BASE_URL; // e.g. '/landing-01/'

const navLinks = [
  { label: t("layout.header.nav.home"), href: base },
  { label: t("layout.header.nav.about"), href: `${base}/about` },
  { label: t("layout.header.nav.menu"), href: `${base}/menu` },
  { label: t("layout.header.nav.booking"), href: `${base}/booking` },
  { label: t("layout.header.nav.contact"), href: `${base}/contact` },
];

// Normalize: strip trailing slash, keep bare '/' for root
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="fixed top-0 left-0 right-0 z-50 bg-black/80 text-white transition-all duration-300">
  <!-- Top banner -->
  <div
    class="relative w-full bg-brand-green overflow-hidden whitespace-nowrap text-xs py-1 px-4 z-50"
  >
    <div class="inline-block animate-marquee-lr">
      {t("layout.header.banner")}
    </div>
  </div>

  <div class="container flex items-center justify-between py-2">
    <!-- Logo -->
    <a href={base} class="flex-shrink-0">
      <Image src={logo} alt={t("layout.header.logo_alt")} class="h-16 w-auto" />
    </a>

    <!-- Desktop nav -->
    <div class="hidden lg:flex">
      <nav class="lg:flex items-center gap-10 text-base font-semibold uppercase tracking-wider">
        {
          navLinks.map(({ label, href }) => (
            <a
              href={href}
              class:list={[
                "hover:text-brand-gold transition-all duration-300 relative group pb-1",
                { "text-brand-gold": currentPath === href },
              ]}
            >
              {label}
              <span
                class:list={[
                  "absolute bottom-0 left-0 w-full h-0.5 bg-brand-gold transform origin-left transition-transform duration-300",
                  currentPath === href ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100",
                ]}
              />
            </a>
          ))
        }
      </nav>
    </div>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-toggle"
      aria-label="Mở menu"
      class="lg:hidden absolute right-4 top-[60px] p-2 rounded focus:outline-none"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile nav -->
  <nav
    id="mobile-menu"
    class="lg:hidden hidden flex-col gap-2 px-4 pb-4 text-base font-medium bg-black/90"
  >
    {
      navLinks.map(({ label, href }) => (
        <a
          href={href}
          class:list={[
            "block py-3 border-b border-white/10 hover:text-brand-gold transition-colors text-center",
            { "text-brand-gold": currentPath === href },
          ]}
        >
          {label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  @keyframes marquee-lr {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100vw);
    }
  }
  .animate-marquee-lr {
    animation: marquee-lr 15s linear infinite;
  }
</style>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => menu?.classList.toggle("hidden"));
</script>
