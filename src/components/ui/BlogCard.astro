---
import type { BlogPost } from '@/types';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<article class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-lg transition-shadow duration-300 group">
  <a href={`/news/${post.slug}`}>
    <div class="aspect-video overflow-hidden">
      <img
        src={post.thumbnail || '/images/placeholder-blog.jpg'}
        alt={post.title}
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    </div>
    <div class="p-5">
      <time class="text-xs text-gray-400 mb-2 block">{post.publishedAt}</time>
      <h3 class="font-bold text-brand-green line-clamp-2 mb-2 group-hover:text-brand-gold transition-colors">
        {post.title}
      </h3>
      <p class="text-gray-500 text-sm line-clamp-3">{post.excerpt}</p>
    </div>
  </a>
</article>
