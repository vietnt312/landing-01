---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="relative overflow-hidden pt-16 pb-24">
  <!-- Section Background -->
  <div class="absolute inset-0 z-0">
    <!-- Base Image -->
    <div class="absolute inset-0 bg-[url('/images/slider-be-thui-ha-noi.jpg')] bg-cover bg-center">
    </div>
    <!-- Blur Overlay Layer -->
    <div class="absolute inset-0 backdrop-blur-sm bg-black/40"></div>
  </div>

  <div class="container relative z-10 max-w-4xl mx-auto px-4">
    <!-- Title -->
    <div class="text-center">
      <h1
        class="text-3xl md:text-5xl font-bold text-brand-gold mb-6 uppercase tracking-wide custom-text-shadow"
      >
        {title}
      </h1>
      <div class="h-1 w-24 bg-brand-gold mx-auto rounded-full shadow-lg"></div>
    </div>
  </div>

  <!-- Shape Divider -->
  <div class="absolute bottom-0 left-0 w-full leading-[0] z-0">
    <svg
      class="relative block w-[calc(100%+1.3px)] h-[60px] md:h-[100px]"
      viewBox="0 0 1000 300"
      xmlns="http://www.w3.org/2000/svg"
      preserveAspectRatio="none"
    >
      <path
        class="fill-white"
        opacity="0.05"
        d="M1014 264V386H206L34 300C34 300 344.42 277.16 436 221C542 156 590 160 704 209C811 255 899.11 214.94 979 346L1014 264Z"
      ></path>
      <path
        class="fill-white"
        opacity="0.1"
        d="M-302 55C-302 55 -66.73 263.25 50 214C178 160 283 116 353 141C445.68 174.1 534.28 256.19 588 249C692.9 235 764.52 75.94 855 131C940.61 183.09 1000 254 1000 254V328L-306 338L-302 55Z"
      ></path>
      <path
        class="fill-white"
        opacity="0.15"
        d="M-286 255C-286 255 -72 152 52 126C176 100 255 155 436 227C581.57 284.91 614.7 277.79 708 227C787 184 1009 3.0001 1093 164C1146 265.63 1031 293 1031 293L924 377L-288 389L-286 255Z"
      ></path>
      <path
        class="fill-white"
        opacity="0.3"
        d="M-24 69C-24 69 275.68 370.66 389 314C397 310 622 316 673 356C690.47 369.7 845 224 890 182C944.8 130.85 1018 92 1078 143C1154.12 207.7 1196 242 1196 242L1184 374L-28 386L-24 69Z"
      ></path>
      <path
        class="fill-white"
        d="M-12 201C-12 201 58 284 182 258C306 232 342.29 221.23 456 264C565 305 640.82 288.36 721 249C776 222 837.5 191.31 935 253C984 284 1030 279 1030 279L1024 430L-12 440V201Z"
      ></path>
    </svg>
  </div>
</div>

<style>
  .custom-text-shadow {
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
  }
</style>
