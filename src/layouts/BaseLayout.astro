---
import favicon from "@/assets/favicon.png";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Bê Thui Hà Nội",
  description = "Hệ thống Nhà hàng Bê thui Hà Nội - Quán nhậu sân vườn",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
let addPadding = false;
const currentPath = path.replace(/\/$/, "") || "/";
addPadding = !(currentPath.endsWith("/index.html") || currentPath.endsWith(base));
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={favicon.src} />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main>
      <div class:list={[{ "pt-24 md:pt-24 bg-brand-green": addPadding }]}></div>
      <slot />
    </main>
    <Footer />
  </body>
</html>
