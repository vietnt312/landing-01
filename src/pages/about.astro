---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Giới thiệu - Bê Thui Hà Nội" description="Câu chuyện về Nhà hàng Bê Thui Hà Nội">

  <div class="bg-brand-green text-white py-16 text-center">
    <h1 class="text-4xl font-bold mb-2">Giới thiệu</h1>
    <p class="opacity-80">Câu chuyện của chúng tôi</p>
  </div>

  <section class="py-16">
    <div class="container max-w-3xl prose prose-green mx-auto">
      <h2>Về Bê Thui Hà Nội</h2>
      <p>
        <!-- TODO: Replace with real content from Google Sheets or CMS -->
        Bê Thui Hà Nội là hệ thống nhà hàng chuyên phục vụ các món bê thui, thịt nướng và các đặc sản Hà Nội
        trong không gian sân vườn xanh mát, thoáng đãng.
      </p>
      <p>
        Với hơn 10 năm kinh nghiệm, chúng tôi tự hào mang đến những bữa ăn ngon, chất lượng và không gian
        thân thiện cho gia đình và bạn bè.
      </p>
    </div>
  </section>

</BaseLayout>
