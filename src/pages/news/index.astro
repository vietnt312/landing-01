---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogCard from '@/components/ui/BlogCard.astro';
import { getBlogPosts } from '@/lib/googleSheets';

const posts = await getBlogPosts();
---

<BaseLayout title="Tin tức - Bê Thui Hà Nội" description="Tin tức và sự kiện từ Bê Thui Hà Nội">

  <div class="bg-brand-green text-white py-16 text-center">
    <h1 class="text-4xl font-bold mb-2">Tin tức & Sự kiện</h1>
    <p class="opacity-80">Cập nhật những tin mới nhất</p>
  </div>

  <section class="py-16">
    <div class="container">
      {posts.length === 0 ? (
        <p class="text-center text-gray-500">Chưa có bài viết nào.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>
      )}
    </div>
  </section>

</BaseLayout>
