---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Liên hệ - Bê Thui Hà Nội" description="Liên hệ với Nhà hàng Bê Thui Hà Nội">

  <div class="bg-brand-green text-white py-16 text-center">
    <h1 class="text-4xl font-bold mb-2">Liên hệ</h1>
    <p class="opacity-80">Chúng tôi luôn sẵn sàng phục vụ bạn</p>
  </div>

  <section class="py-16">
    <div class="container grid grid-cols-1 md:grid-cols-2 gap-12">

      <!-- Contact info -->
      <div>
        <h2 class="text-2xl font-bold text-brand-green mb-6">Thông tin liên hệ</h2>
        <ul class="space-y-4 text-gray-700">
          <li class="flex gap-3 items-start">
            <span class="text-2xl">📞</span>
            <div>
              <p class="font-medium">Hotline</p>
              <a href="tel:0828662929" class="text-brand-gold hover:underline">082.866.2929</a>
            </div>
          </li>
          <li class="flex gap-3 items-start">
            <span class="text-2xl">✉️</span>
            <div>
              <p class="font-medium">Email</p>
              <a href="mailto:bethuihanoi@gmail.com" class="text-brand-gold hover:underline">
                bethuihanoi@gmail.com
              </a>
            </div>
          </li>
          <li class="flex gap-3 items-start">
            <span class="text-2xl">📍</span>
            <div>
              <p class="font-medium">Địa chỉ</p>
              <p>28 Nguyễn Hữu Thọ, Định Công, Hà Nội</p>
            </div>
          </li>
        </ul>
      </div>

      <!-- Map -->
      <div class="rounded-2xl overflow-hidden aspect-video md:aspect-auto">
        <iframe
          src="https://maps.google.com/maps?q=28+Nguyen+Huu+Tho,+Dinh+Cong,+Hanoi&output=embed"
          class="w-full h-full min-h-[300px] border-0"
          loading="lazy"
          title="Bản đồ nhà hàng"
        ></iframe>
      </div>

    </div>
  </section>

</BaseLayout>
