---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getText as t, getSiteConfig } from '@/lib/googleSheets';

const config = getSiteConfig();
const mapSrc = config.mapEmbedUrl ?? 'https://maps.google.com/maps?q=28+Nguyen+Huu+Tho,+Dinh+Cong,+Hanoi&output=embed';
---

<BaseLayout title="Liên hệ - Bê Thui Hà Nội" description="Liên hệ với Nhà hàng Bê Thui Hà Nội">

  <div class="bg-brand-green text-white py-16 text-center">
    <h1 class="text-4xl font-bold mb-2">{t('pages.contact.header_title')}</h1>
    <p class="opacity-80">{t('pages.contact.header_subtitle')}</p>
  </div>

  <section class="py-16">
    <div class="container grid grid-cols-1 md:grid-cols-2 gap-12">

      <!-- Contact info -->
      <div>
        <h2 class="text-2xl font-bold text-brand-green mb-6">{t('pages.contact.section_title')}</h2>
        <ul class="space-y-4 text-gray-700">
          <li class="flex gap-3 items-start">
            <span class="text-2xl">📞</span>
            <div>
              <p class="font-medium">{t('pages.contact.hotline_label')}</p>
              <a href={`tel:${config.hotline}`} class="text-brand-gold hover:underline">{config.hotline}</a>
            </div>
          </li>
          <li class="flex gap-3 items-start">
            <span class="text-2xl">✉️</span>
            <div>
              <p class="font-medium">{t('pages.contact.email_label')}</p>
              <a href={`mailto:${config.email}`} class="text-brand-gold hover:underline">
                {config.email}
              </a>
            </div>
          </li>
          <li class="flex gap-3 items-start">
            <span class="text-2xl">📍</span>
            <div>
              <p class="font-medium">{t('pages.contact.address_label')}</p>
              <p>{config.address}</p>
            </div>
          </li>
        </ul>
      </div>

      <!-- Map -->
      <div class="rounded-2xl overflow-hidden aspect-video md:aspect-auto">
        <iframe
          src={mapSrc}
          class="w-full h-full min-h-[300px] border-0"
          loading="lazy"
          title={t('pages.contact.map_title')}
        ></iframe>
      </div>

    </div>
  </section>

</BaseLayout>
