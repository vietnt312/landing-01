# Copy to .env and fill in your values
# These are set as GitHub Actions secrets for production builds

# Google Sheets — publish each sheet as CSV:
#   File → Share → Publish to web → select sheet → CSV → Copy link
GOOGLE_SHEET_MENU_URL=
GOOGLE_SHEET_BLOG_URL=
GOOGLE_SHEET_GALLERY_URL=
GOOGLE_SHEET_CONFIG_URL=

# Booking form endpoint (e.g. Formspree: https://formspree.io/f/YOUR_ID)
BOOKING_FORM_ENDPOINT=
