# Copy to .env and fill in your values
# These are set as GitHub Actions secrets for production builds

# Google Sheets — publish each sheet as CSV:
#   File → Share → Publish to web → select sheet → CSV → Copy link
GOOGLE_SHEET_MENU_URL=
GOOGLE_SHEET_GALLERY_URL=
GOOGLE_SHEET_CONFIG_URL=
GOOGLE_SHEET_SLIDES_URL=
GOOGLE_SHEET_TEXT_URL=

# Booking — Google Form pre-fill
# BOOKING_FORM_ENDPOINT: base URL of your Google Form
#   e.g. https://docs.google.com/forms/d/e/FORM_ID/viewform
# BOOKING_FIELD_*: entry IDs for each field
#   How to find: open the Google Form → right-click an input → Inspect
#   Look for name="entry.XXXXXXXXX" on the <input> element
BOOKING_FORM_ENDPOINT=
